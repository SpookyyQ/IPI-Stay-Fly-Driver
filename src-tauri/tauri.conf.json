{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "IPI STAY FLY Driver",
    "version": "1.5.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "process": {
        "all": false,
        "relaunch": true
      },
      "window": {
        "all": false,
        "close": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "startDragging": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.ipi.flyprodriver",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/SpookyyQ/IPI-Stay-Fly-Driver/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0N0VENTVFRTUxMjY0QTUKUldTbFpCTGxYdFYrUkR6UmtoU0p6OEFwclV5c00zR0Vua1BFWE1Sai9TRnhrV0l5MWZDN1R3MEgK"
    },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "title": "IPI STAY FLY Driver"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "decorations": false,
        "resizable": true,
        "title": "IPI STAY FLY Driver",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620
      },
      {
        "label": "tray",
        "url": "index.html",
        "title": "IPI STAY FLY",
        "width": 180,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ]
  }
}
